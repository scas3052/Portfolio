rules_version = '2';

// Security rules for Gullak's cloud sync. The README's "Cloud sync (Firebase)" section has the
// whole setup; in short:
//
//   1. Copy this file to firestore.rules. That copy is git-ignored, so your email stays out of
//      the repository.
//   2. Replace the placeholder in owners() with the Google account(s) allowed to sync, in lower
//      case.
//   3. Deploy it: npx firebase-tools deploy --only firestore --project <your-project-id>
//
// Each owner reads and writes only their own book: users/{uid}/book/core plus one document per
// month (YYYY-MM). Every other path, and every other account, is refused. Anyone else who signs in
// on the site simply keeps using Gullak in their own browser.
service cloud.firestore {
  match /databases/{database}/documents {
    function owners() {
      return ['you@example.com'];
    }

    function isOwner(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in owners();
    }

    match /users/{uid}/book/{docId} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) && docId.matches('^(core|[0-9]{4}-[0-9]{2})$');
    }
  }
}
