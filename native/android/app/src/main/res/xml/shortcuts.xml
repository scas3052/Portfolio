<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the Gullak icon: Scan & Pay opens straight on the QR scanner. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_scan"
        android:shortcutId="scan_pay"
        android:shortcutLongLabel="@string/shortcut_scan_long"
        android:shortcutShortLabel="@string/shortcut_scan_short">
        <intent
            android:action="com.scas3052.gullak.SCAN_PAY"
            android:targetClass="com.scas3052.gullak.MainActivity"
            android:targetPackage="com.scas3052.gullak" />
    </shortcut>
</shortcuts>
