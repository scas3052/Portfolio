<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/gullak_ink</item>
        <item name="colorPrimaryDark">@color/gullak_ink</item>
        <item name="colorAccent">@color/gullak_lime</item>
        <item name="android:windowBackground">@color/gullak_paper</item>
    </style>

    <!-- Capacitor switches the activity to this theme once the web view starts. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/gullak_paper</item>
    </style>

    <!-- Launch screen: the Gullak tile on paper, on every Android version (androidx core-splashscreen). -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/gullak_paper</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/gullak_splash_icon</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
