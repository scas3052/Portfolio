# Gullak assistant ("Munshi") relay settings, plus optional cloud sync at the end.
# Copy to .env.local for `npm run dev`, or add these as environment variables on
# Vercel / Netlify. Never prefix the relay settings with VITE_ — that would ship them to the browser.

# Required. 12+ characters. You type the same passphrase in Gullak → Settings → Munshi.
AGENT_PASSPHRASE=

# At least one provider key. All of these have free tiers; with several keys the
# relay falls back to the next provider when one is rate-limited or down.
# Groq: https://console.groq.com/keys
GROQ_API_KEY=
# OpenRouter: https://openrouter.ai/keys (uses the free model router by default)
OPENROUTER_API_KEY=
# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Cerebras: https://cloud.cerebras.ai
CEREBRAS_API_KEY=
# Mistral: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
# NVIDIA NIM: https://build.nvidia.com
NVIDIA_API_KEY=
# Hugging Face: https://huggingface.co/settings/tokens
HF_TOKEN=

# Optional: any OpenAI-compatible server you run, e.g. Ollama (local dev only).
# CUSTOM_LLM_BASE_URL=http://localhost:11434/v1
# CUSTOM_LLM_MODEL=llama3.1
# CUSTOM_LLM_API_KEY=

# Optional: provider order (and restriction), comma-separated ids:
# groq, openrouter, cerebras, nvidia, mistral, hf, gemini, custom
# AGENT_PROVIDERS=groq,openrouter

# Optional: override a provider's model with <ID>_MODEL, e.g.
# GROQ_MODEL=openai/gpt-oss-20b
# OPENROUTER_MODEL=openrouter/free

# Optional: extra origins allowed to call the relay (comma-separated), e.g. when
# the site is on GitHub Pages and the relay runs on Vercel/Netlify. The Android app
# calls the relay from https://localhost, so add that once you use the app.
# AGENT_ALLOWED_ORIGINS=https://yourname.github.io,https://localhost


# ---------------------------------------------------------------------------
# Gullak cloud sync (Firebase, free Spark plan). Optional: leave these empty and
# Gullak keeps each book in its own browser, with no sign-in button anywhere.
# Full setup: README → "Cloud sync (Firebase)".
#
# Unlike the relay settings above, these DO start with VITE_: the browser needs them
# to reach Firebase, so Vite builds them into the page on purpose. They only name
# your Firebase project and aren't secrets; firestore.rules decides who can read or
# write. They're read at build time, so redeploy after changing them on Vercel/Netlify.
#
# Find them in the Firebase console → Project settings → General → Your apps → your
# web app → "SDK setup and configuration" → Config. The first three are required.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=


# ---------------------------------------------------------------------------
# Gullak Android app (README → "Gullak Android app"). These are read by
# `npm run build:app` only; GitHub Actions sets them from the repository's variables,
# so you rarely need them here. Leave them unset for `npm run dev:app`, which runs
# Munshi's relay locally.
#
# The site the app talks to, for Munshi and update checks:
# VITE_GULLAK_SITE_URL=https://your-site.vercel.app
# VITE_AGENT_ENDPOINT=https://your-site.vercel.app/api/agent
#
# Google sign-in inside the app: Firebase console → Authentication → Sign-in method →
# Google → Web SDK configuration → Web client ID.
# VITE_GOOGLE_WEB_CLIENT_ID=
#
# Only to publish an APK by hand with scripts/upload-apk.mjs (Vercel → Storage → your
# Blob store). Never prefix it with VITE_.
# BLOB_READ_WRITE_TOKEN=
