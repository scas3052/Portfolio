# Gullak assistant ("Munshi") relay settings.
# Copy to .env.local for `npm run dev`, or add these as environment variables on
# Vercel / Netlify. Never prefix them with VITE_ — that would ship them to the browser.

# Required. 12+ characters. You type the same passphrase in Gullak → Settings → Munshi.
AGENT_PASSPHRASE=

# At least one provider key. All of these have free tiers; with several keys the
# relay falls back to the next provider when one is rate-limited or down.
# Groq: https://console.groq.com/keys
GROQ_API_KEY=
# OpenRouter: https://openrouter.ai/keys (uses the free model router by default)
OPENROUTER_API_KEY=
# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Cerebras: https://cloud.cerebras.ai
CEREBRAS_API_KEY=
# Mistral: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
# NVIDIA NIM: https://build.nvidia.com
NVIDIA_API_KEY=
# Hugging Face: https://huggingface.co/settings/tokens
HF_TOKEN=

# Optional: any OpenAI-compatible server you run, e.g. Ollama (local dev only).
# CUSTOM_LLM_BASE_URL=http://localhost:11434/v1
# CUSTOM_LLM_MODEL=llama3.1
# CUSTOM_LLM_API_KEY=

# Optional: provider order (and restriction), comma-separated ids:
# groq, openrouter, cerebras, nvidia, mistral, hf, gemini, custom
# AGENT_PROVIDERS=groq,openrouter

# Optional: override a provider's model with <ID>_MODEL, e.g.
# GROQ_MODEL=openai/gpt-oss-20b
# OPENROUTER_MODEL=openrouter/free

# Optional: extra origins allowed to call the relay (comma-separated), e.g. when
# the site is on GitHub Pages and the relay runs on Vercel/Netlify.
# AGENT_ALLOWED_ORIGINS=https://yourname.github.io
